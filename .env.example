# ── Provider selection ──────────────────────────────────────────────────────
LLM_PROVIDER=vertex            # vertex | openai_compat
EMBEDDING_PROVIDER=vertex      # vertex | local
RERANK_PROVIDER=vertex         # vertex | local | none

# ── Vertex AI ───────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex_credentials.json
VERTEX_LLM_MODEL=gemini-2.0-flash-latest
VERTEX_LLM_FAST_MODEL=gemini-2.0-flash-latest
VERTEX_EMBEDDING_MODEL=
VERTEX_EMBEDDING_DIM=
VERTEX_RERANK_MODEL=

# ── On-prem (OpenAI-compatible / vLLM) ──────────────────────────────────────
OPENAI_COMPAT_BASE_URL=http://vllm:8000/v1
OPENAI_COMPAT_API_KEY=local
OPENAI_COMPAT_MODEL=
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DIM=1024
LOCAL_EMBEDDING_URL=
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ascend:ascend@postgres:5432/ascend

# ── API ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:25173,http://localhost:5173
RATE_LIMIT_ANALYSES=10/minute

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
